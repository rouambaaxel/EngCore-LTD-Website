# Copiez ce fichier en .env.local puis remplacez chaque valeur.
#
# Un .env.local laissé avec ces valeurs d'exemple fait pointer le site vers un
# domaine qui n'existe pas : chaque page attendrait un DNS qui n'aboutit pas.
# Le site le détecte et bascule sur le catalogue de démonstration, mais tant
# que Supabase n'est pas créé, mieux vaut supprimer le fichier.

# --- Base de données et authentification -----------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Clé de service, côté serveur uniquement. Sans elle, les webhooks de paiement
# ne peuvent pas marquer une commande réglée — c'est justement l'écriture
# qu'aucun client n'a le droit de faire. Ne jamais la préfixer NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL publique du site : retours Stripe, liens d'invitation, liens de suivi.
# En production, le domaine réel — sans quoi les liens envoyés par mail
# renverraient le client sur sa propre machine. Sur Vercel, le domaine du
# projet sert de repli si cette variable est absente.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Carte bancaire (Stripe) -----------------------------------------------
# Sans STRIPE_SECRET_KEY, le moyen « carte » n'est pas proposé au client.
STRIPE_SECRET_KEY=sk_test_...
# Obtenu en créant l'endpoint webhook dans le tableau de bord Stripe, sur
# l'événement checkout.session.completed, vers /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# ── 4. Virement international : un compte par devise ────────────────────────
# Chaque compte s'active des que son IBAN et son BIC sont renseignes.
# Un compte laisse vide n'est simplement pas propose au client.
# Le devis reste en livres ; euro et dollar sont convertis au taux du jour.

# Marge appliquee au taux de change, en pourcentage. Couvre le risque de
# change entre l'emission du devis et l'encaissement, et les frais bancaires.
FX_MARGIN_PERCENT=5

# Titulaire commun aux trois comptes, sauf mention contraire par devise.
BANK_ACCOUNT_NAME=Engcore Ltd

# Livre sterling
BANK_GBP_NAME=
BANK_GBP_IBAN=
BANK_GBP_SWIFT=
BANK_GBP_ADDRESS=

# Euro
BANK_EUR_NAME=
BANK_EUR_IBAN=
BANK_EUR_SWIFT=
BANK_EUR_ADDRESS=

